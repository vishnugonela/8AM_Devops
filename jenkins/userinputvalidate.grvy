//write a pipeline script to accept user input and validate

pipeline{
agent any 

parameters {
        string(name: 'username', defaultValue: '', description: 'Enter your username')
    }


stages{
 stage("userinput validate"){
 steps{
 sh '''  
echo "enter your username"
  
if [ -z "$username" ];
then 
echo "error:username is empty.pl provide a valid username"
#exit 1

else

echo "username entered "

fi

'''

}



}


}


}
