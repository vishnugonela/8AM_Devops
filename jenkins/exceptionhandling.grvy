#Write a pipeline script to execute exception error or error handling
pipeline{
agent any
stages {
 stage ('exception eror')
 steps{
sh '''
#!/bin/bash
echo "step1:simulate task"

sleep1
echo "step2  :execute with error"
false

if [$? -ne 0];
then 
echo "error found"
exit 1

fi
echo"step 3:cannot run with above error"

'''




}

}






}









}
